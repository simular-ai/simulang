{
  "name": "@simular-ai/simulang",
  "version": "6.0.0",
  "description": "Simulang CLI — run Simulang scripts (.simulang) on Node with full @simular-ai/simulang-js capability.",
  "type": "module",
  "bin": {
    "simulang": "dist/bin/simulang.js"
  },
  "engines": {
    "node": ">= 22.18"
  },
  "files": [
    "dist",
    "scripts",
    "SKILL.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simular-ai/simulang-cli.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@simular-ai/simulang-js": ">=0.0.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\" && tsc && node -e \"require('node:fs').chmodSync('./dist/bin/simulang.js', 0o755)\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "format": "prettier . -w",
    "lint": "oxlint .",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  }
}
